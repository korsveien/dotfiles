#!/usr/bin/env python3
"""Select the kitty font with fzf.

The font changes when the cursor moves in the list. Enter keeps the font.
Esc restores the font that was active at start.

The script edits the font_family line in the BEGIN_KITTY_FONTS block of
kitty.conf (the same block that `kitten choose-fonts` writes). Then it sends
SIGUSR1 to kitty, and kitty loads the config again.

Usage:
    kfont            select a font with fzf
    kfont <family>   set the font directly
"""

import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("KITTY_CONFIG_DIRECTORY", Path.home() / ".config/kitty"))
CONFIG = CONFIG_DIR / "kitty.conf"

FONT_BLOCK = re.compile(r"# BEGIN_KITTY_FONTS\n.*?# END_KITTY_FONTS", re.S)
FONT_FAMILY = re.compile(r"^font_family[ \t]+(.*)$", re.M)

# fc-list shows each weight as a separate family. Only the base family is useful here.
WEIGHT_SUFFIX = re.compile(
    r" (Thin|ExtraLight|ExtLt|Light|Medium|Medm|SemiBold|SmBld|Bold|ExtraBold|Black)$"
)
# Nerd Fonts register short aliases ("JetBrainsMono NF") next to the full names.
NERD_ALIAS = re.compile(r" NFM?( |$)")

SAMPLE = """\
0O o 1lI| rn m vv w  5S 2Z 8B
{}[]() <= >= != == => -> :: ;
fn main() { let x = 0x1F; }
if (a && b || !c) return i++;
æøå ÆØÅ  "quote" 'tick' `back`
"""


def mono_families() -> list[str]:
    out = subprocess.run(
        ["fc-list", ":spacing=mono:style=Regular", "family"],
        capture_output=True, text=True, check=True,
    ).stdout
    names = {name.strip() for line in out.splitlines() for name in line.split(",")}
    return sorted(
        name for name in names
        if name
        and not name.startswith(".")
        and "Emoji" not in name
        and not WEIGHT_SUFFIX.search(name)
        and not NERD_ALIAS.search(name)
    )


def font_block(text: str) -> re.Match:
    block = FONT_BLOCK.search(text)
    if not block:
        sys.exit(f"kfont: no BEGIN_KITTY_FONTS block in {CONFIG}")
    return block


def current_family() -> str:
    block = font_block(CONFIG.read_text()).group(0)
    line = FONT_FAMILY.search(block)
    if not line:
        return ""
    value = line.group(1).strip()
    quoted = re.fullmatch(r'family="(.*)"', value)
    return quoted.group(1) if quoted else value


def apply(family: str) -> None:
    text = CONFIG.read_text()
    block = font_block(text)
    line = f'font_family      family="{family}"'
    old = block.group(0)
    if FONT_FAMILY.search(old):
        new = FONT_FAMILY.sub(lambda _: line, old, count=1)
    else:
        new = old.replace("# BEGIN_KITTY_FONTS\n", f"# BEGIN_KITTY_FONTS\n{line}\n", 1)
    if new != old:
        # Write to a temporary file first, so kitty never reads a half-written config.
        tmp = CONFIG.with_name(CONFIG.name + ".kfont-tmp")
        tmp.write_text(text[: block.start()] + new + text[block.end():])
        os.replace(tmp, CONFIG)
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], check=False)


def select() -> None:
    original = current_family()
    families = mono_families()
    if original in families:
        families.remove(original)
        families.insert(0, original)

    self_cmd = f"{shlex.quote(sys.executable)} {shlex.quote(str(Path(__file__).resolve()))}"
    result = subprocess.run(
        [
            "fzf",
            "--prompt", "font> ",
            "--header", f"now: {original}   enter: keep   esc: restore",
            "--bind", f"focus:execute-silent({self_cmd} {{}})",
            "--preview", f"{self_cmd} --sample",
            "--preview-window", "down,7,border-top",
        ],
        input="\n".join(families), stdout=subprocess.PIPE, text=True,
    )
    choice = result.stdout.strip()
    if result.returncode == 0 and choice:
        apply(choice)
        print(choice)
    else:
        apply(original)


def main() -> None:
    args = sys.argv[1:]
    if not args:
        select()
    elif args == ["--sample"]:
        print(SAMPLE, end="")
    elif args[0] in ("-h", "--help"):
        print(__doc__.strip())
    else:
        apply(" ".join(args))


if __name__ == "__main__":
    main()
